# Root .env.example — Docker Compose environment variables
# Copy to .env and fill in your real values.
# This file is read automatically by: docker compose up / docker compose build
#
# WHY a root .env in addition to backend/.env and frontend/.env?
# ─────────────────────────────────────────────────────────────
# • backend/.env  — used by `npm run dev` (backend) and nodemon
# • frontend/.env — used by `npm run dev` (Vite dev server)
# • THIS FILE     — used by Docker Compose to inject build-args and runtime
#                   env vars into both containers at build/run time.
#
# VITE_* vars must be in THIS file because Vite bakes them into the JS bundle
# at docker build time. The frontend container's build stage cannot read
# frontend/.env — only the root .env (this file) is visible to Compose.

# ── Backend runtime ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — REQUIRED for JWT verification on authenticated routes.
# Without these every call to /api/quiz/stats, /api/google-drive/status, etc.
# returns 401 Unauthorized because the backend cannot validate the user token.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Drive OAuth (only needed for Drive integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-drive/callback
GOOGLE_DRIVE_ENCRYPTION_KEY=your_64_char_hex_key_here
FRONTEND_URL=http://localhost:3000

# ── Frontend build-time (Vite) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
