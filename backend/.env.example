# Backend Environment Variables — Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── AI / Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── Supabase (server-side only) ───────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # service_role secret key (NEVER expose to frontend)

# ── Google OAuth for Google Drive ─────────────────────────────────────────────
# Get these from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LOCAL:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-drive/callback
# PRODUCTION (update to your actual backend domain):
# GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/google-drive/callback

# ── Refresh Token Encryption ──────────────────────────────────────────────────
# 32 random bytes encoded as hex (64 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_DRIVE_ENCRYPTION_KEY=

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# PRODUCTION:
# FRONTEND_URL=https://your-frontend.vercel.app

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
# PRODUCTION (comma-separated):
# CORS_ORIGINS=https://your-frontend.vercel.app
